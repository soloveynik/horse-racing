{
    "name": "soloveynik/horse-racing",
    "description": "Horse Racing - Lab 3",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "robmorgan/phinx": "0.16.5"
    },
    "require-dev": {
        "phpunit/phpunit": "11.5.57",
        "phpstan/phpstan": "1.12.32",
        "squizlabs/php_codesniffer": "3.13.5",
        "phpstan/phpstan-strict-rules": "1.6.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "policy": {
            "advisories": {
                "ignore-id": [
                    "PKSA-rdkp-vv9z-mjkg"
                ]
            }
        },
        "audit": {
            "block": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
