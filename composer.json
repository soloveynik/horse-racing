{
    "name": "soloveynik/horse-racing",
    "description": "\u0412\u0435\u0431-\u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u0443\u0447\u0451\u0442\u0430 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438 \u043e \u0441\u043a\u0430\u0447\u043a\u0430\u0445",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "robmorgan/phinx": "0.16.5"
    },
    "require-dev": {
        "phpunit/phpunit": "11.5.57",
        "phpstan/phpstan": "1.12.32",
        "squizlabs/php_codesniffer": "3.13.5",
        "phpstan/phpstan-strict-rules": "1.6.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-html=build/coverage",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse",
        "migrate": "phinx migrate",
        "migrate:status": "phinx status",
        "migrate:rollback": "phinx rollback"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.2.0"
        },
        "audit": {
            "block": false
        },
        "policy": {
            "advisories": {
                "ignore-id": [
                    "PKSA-rdkp-vv9z-mjkg",
                    "PKSA-z3gr-8qht-p93v"
                ]
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
