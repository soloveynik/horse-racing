<?xml version="1.0"?>
<ruleset name="HorseRacing">
    <description>PSR-12 coding standard for Horse Racing project</description>

    <file>src</file>
    <file>tests</file>
    <file>api</file>
    <file>config</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>build/*</exclude-pattern>
    <exclude-pattern>database/migrations/*</exclude-pattern>
    <exclude-pattern>public/*</exclude-pattern>

    <rule ref="PSR12"/>

    <arg name="colors"/>
    <arg value="p"/>
    <arg name="extensions" value="php"/>
</ruleset>
